# Local single-user configuration. Never commit real credentials or private data.
# Settings reads process environment variables; it does not automatically load this file.
# For local development, copy to .env.local and start the backend with:
# python -m uvicorn macro_research_agent.app:create_app --factory --app-dir backend/src --env-file .env.local --host 127.0.0.1 --port 8000
# Keep both services bound to loopback. HTTP authentication is not implemented.

# Planning, stage assistance, chart/report authoring and self-checks use DeepSeek.
# Use the model identifier available to your account; no production fallback is enabled.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
# Optional per-role model overrides; blank inherits DEEPSEEK_MODEL.
MRA_DATA_AI_MODEL=
MRA_ANALYSIS_AI_MODEL=
MRA_REPORT_AUTHOR_MODEL=
MRA_REPORT_AUTHOR_MAX_OUTPUT_TOKENS=12000
MRA_REPORT_AUTHOR_MAX_DATA_ROWS=2000
MRA_STAGE_AI_MAX_ATTEMPTS=2
MRA_STAGE_AI_TIMEOUT_SECONDS=45
MRA_STAGE_AI_MAX_PROMPT_CHARS=250000
MRA_STAGE_AI_MAX_OUTPUT_TOKENS=4000
# Output review uses an installed and authenticated Codex CLI, not a project API key.
# "Local" describes the adapter process, not offline inference: review sends evidence to AI.
MRA_OUTPUT_REVIEW_PROVIDER=codex-local
MRA_OUTPUT_REVIEW_MODEL=
MRA_OUTPUT_REVIEW_CODEX_BIN=codex
MRA_OUTPUT_REVIEW_TIMEOUT_SECONDS=120
MRA_PLANNING_MAX_ATTEMPTS=2
MRA_PLANNING_TIMEOUT_SECONDS=45
MRA_PLANNING_MAX_DATA_ROWS=2000
MRA_PLANNING_MAX_PROMPT_CHARS=250000
MRA_PLANNING_MAX_OUTPUT_TOKENS=4000

# Actual data access by AI, not just schema/sample access. Read SECURITY.md first.
# Public data access follows MRA_AI_DATA_ACCESS; user uploads also require the next flag.
# These settings default to true in code, so disable them before starting if not authorized.
MRA_AI_DATA_ACCESS=true
MRA_AI_DATA_PAGE_SIZE=200
MRA_AI_REMOTE_USER_DATA_ALLOWED=true
# Keep false. This flag alone does not admit a licensed connector or authorize disclosure.
MRA_AI_REMOTE_LICENSED_DATA_ALLOWED=false

# Local application paths
MRA_RUNTIME_DIR=runtime
MRA_MAX_UPLOAD_MB=100
MRA_GRAPH_ORPHAN_TIMEOUT_SECONDS=300

# The eight currently admitted public provider slices do not require API-key variables.
# This file does not enable additional datasets, licensed connectors or provider profiles.
# Frontend configuration belongs in the frontend process: VITE_WORKFLOW_ADAPTER=http
